# Copy to .env for local runs. On a host, set these in its dashboard instead.

# debug | info | warn | error
LOG_LEVEL=info

# Where the write-ahead log lives. Must be persistent storage in production.
DATA_DIR=data

# Config file location (default ./config.yml). Alternatively put the whole YAML
# document in CONFIG_YAML, which wins over the file.
# CONFIG_PATH=config.yml
# CONFIG_YAML=

# Referenced from config.example.yml as ${SUBMISSIONS_CHANNEL_ID} / ${LINKS_CHANNEL_ID}.
SUBMISSIONS_CHANNEL_ID=
LINKS_CHANNEL_ID=
