{
  "name": "quest-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot that logs community quest submissions (screenshots and links) to Google Sheets, with a local write-ahead log so nothing is lost.",
  "keywords": [
    "discord-bot",
    "google-sheets",
    "community",
    "quests",
    "campaign"
  ],
  "author": "Taha Bakri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tahabakri/quest-ledger.git"
  },
  "homepage": "https://github.com/tahabakri/quest-ledger#readme",
  "bugs": {
    "url": "https://github.com/tahabakri/quest-ledger/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "replay": "node dist/replay.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@googleapis/sheets": "^18.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
